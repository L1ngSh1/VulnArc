{
  "$defs": {
    "Change": {
      "properties": {
        "before": {
          "default": null,
          "title": "Before"
        },
        "after": {
          "default": null,
          "title": "After"
        }
      },
      "title": "Change",
      "type": "object"
    },
    "Evidence": {
      "properties": {
        "type": {
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "date_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date Raw"
        }
      },
      "required": [
        "type"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "HistoryEvent": {
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "event_type": {
          "minLength": 1,
          "title": "Event Type",
          "type": "string"
        },
        "actual_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual At"
        },
        "date_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date Raw"
        },
        "changes": {
          "additionalProperties": {
            "$ref": "#/$defs/Change"
          },
          "title": "Changes",
          "type": "object"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "corrects_event_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Corrects Event Id"
        }
      },
      "required": [
        "id",
        "recorded_at",
        "event_type"
      ],
      "title": "HistoryEvent",
      "type": "object"
    },
    "MaterialRef": {
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "path"
      ],
      "title": "MaterialRef",
      "type": "object"
    },
    "ProcessingStatus": {
      "enum": [
        "unknown",
        "pending_review",
        "triaged",
        "accepted",
        "duplicate",
        "informative",
        "rejected",
        "resolved"
      ],
      "title": "ProcessingStatus",
      "type": "string"
    },
    "SubmissionStatus": {
      "enum": [
        "unknown",
        "not_submitted",
        "submitted",
        "withdrawn"
      ],
      "title": "SubmissionStatus",
      "type": "string"
    }
  },
  "properties": {
    "id": {
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$",
      "title": "Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updated At"
    },
    "history": {
      "items": {
        "$ref": "#/$defs/HistoryEvent"
      },
      "title": "History",
      "type": "array"
    },
    "kind": {
      "const": "report",
      "default": "report",
      "title": "Kind",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "project": {
      "minLength": 1,
      "title": "Project",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "channel": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Channel"
    },
    "external_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "External Id"
    },
    "external_url": {
      "anyOf": [
        {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "External Url"
    },
    "submission_status": {
      "$ref": "#/$defs/SubmissionStatus",
      "default": "unknown"
    },
    "submission_evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Submission Evidence",
      "type": "array"
    },
    "submitted_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Submitted At"
    },
    "submitted_at_raw": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Submitted At Raw"
    },
    "processing_status": {
      "$ref": "#/$defs/ProcessingStatus",
      "default": "unknown"
    },
    "platform_status_raw": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Platform Status Raw"
    },
    "local_status_raw": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Local Status Raw"
    },
    "status_evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Status Evidence",
      "type": "array"
    },
    "status_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Status At"
    },
    "status_at_raw": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Status At Raw"
    },
    "original_report": {
      "anyOf": [
        {
          "$ref": "#/$defs/MaterialRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "related_documents": {
      "items": {
        "$ref": "#/$defs/MaterialRef"
      },
      "title": "Related Documents",
      "type": "array"
    },
    "missing_information": {
      "items": {
        "type": "string"
      },
      "title": "Missing Information",
      "type": "array"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "research_refs": {
      "items": {
        "type": "string"
      },
      "title": "Research Refs",
      "type": "array"
    },
    "source_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Key"
    },
    "import_fingerprint": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Import Fingerprint"
    }
  },
  "required": [
    "id",
    "created_at",
    "project",
    "title"
  ],
  "title": "Report",
  "type": "object"
}
