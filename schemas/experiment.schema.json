{
  "$defs": {
    "ArmMetrics": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "hypotheses": {
          "default": 0,
          "minimum": 0,
          "title": "Hypotheses",
          "type": "integer"
        },
        "validated": {
          "default": 0,
          "minimum": 0,
          "title": "Validated",
          "type": "integer"
        },
        "rejected": {
          "default": 0,
          "minimum": 0,
          "title": "Rejected",
          "type": "integer"
        },
        "unique": {
          "default": 0,
          "minimum": 0,
          "title": "Unique",
          "type": "integer"
        },
        "time_hours": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Hours"
        },
        "tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens"
        },
        "api_cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Cost"
        }
      },
      "required": [
        "name",
        "origin"
      ],
      "title": "ArmMetrics",
      "type": "object"
    },
    "Change": {
      "properties": {
        "before": {
          "default": null,
          "title": "Before"
        },
        "after": {
          "default": null,
          "title": "After"
        }
      },
      "title": "Change",
      "type": "object"
    },
    "Evidence": {
      "properties": {
        "type": {
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "date_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date Raw"
        }
      },
      "required": [
        "type"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "HistoryEvent": {
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "event_type": {
          "minLength": 1,
          "title": "Event Type",
          "type": "string"
        },
        "actual_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual At"
        },
        "date_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date Raw"
        },
        "changes": {
          "additionalProperties": {
            "$ref": "#/$defs/Change"
          },
          "title": "Changes",
          "type": "object"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "corrects_event_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Corrects Event Id"
        }
      },
      "required": [
        "id",
        "recorded_at",
        "event_type"
      ],
      "title": "HistoryEvent",
      "type": "object"
    },
    "Origin": {
      "enum": [
        "human",
        "ai",
        "hybrid"
      ],
      "title": "Origin",
      "type": "string"
    }
  },
  "properties": {
    "id": {
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$",
      "title": "Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updated At"
    },
    "history": {
      "items": {
        "$ref": "#/$defs/HistoryEvent"
      },
      "title": "History",
      "type": "array"
    },
    "kind": {
      "const": "experiment",
      "default": "experiment",
      "title": "Kind",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "target": {
      "title": "Target",
      "type": "string"
    },
    "audit_scope": {
      "title": "Audit Scope",
      "type": "string"
    },
    "time_budget_hours": {
      "exclusiveMinimum": 0,
      "title": "Time Budget Hours",
      "type": "number"
    },
    "arms": {
      "items": {
        "$ref": "#/$defs/ArmMetrics"
      },
      "minItems": 2,
      "title": "Arms",
      "type": "array"
    },
    "overlap": {
      "default": 0,
      "minimum": 0,
      "title": "Overlap",
      "type": "integer"
    },
    "limitations": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "id",
    "created_at",
    "title",
    "target",
    "audit_scope",
    "time_budget_hours",
    "arms"
  ],
  "title": "Experiment",
  "type": "object"
}
